# Base URL the browser uses for API calls.
# Default "/api" goes through the Vite dev proxy (no CORS changes needed on the backend).
# For a deployed build pointing straight at FastAPI, use e.g. https://api.example.com
# (that requires CORSMiddleware on the backend).
VITE_API_BASE_URL=/api

# Dev-server only (not exposed to the browser): where the Vite proxy forwards /api requests.
API_PROXY_TARGET=http://localhost:8000

# Optional ISO 4217 code used only for display formatting (the API stores plain integers).
# Leave empty to show unformatted numbers.
VITE_CURRENCY=
