# Copy to .env and fill in real values. Never commit .env.

# Databases
SQLALCHEMY_URL=postgresql://user:password@localhost:5432/auctionapi
SQLALCHEMY_TEST_URL=postgresql://user:password@localhost:5432/auctionapi_test

# JWT and token lifetimes
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=15

# Outgoing email
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=user@example.com
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Seed accounts, only needed by app/seeders
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Optional: owner of the seeded products, defaults to ADMIN_USERNAME
# SEED_OWNER_USERNAME=

RATE_LIMIT_STORAGE=redis://localhost:6379/2
